---
import '../styles/site.css';
import { config } from '../config';

interface Props {
  title: string;
  description: string;
  /** Path of this page, e.g. "/" or "/privacy", for the canonical URL. */
  path: string;
  /** Landing page shows the section nav; legal pages don't. */
  sectionNav?: boolean;
}
const { title, description, path, sectionNav = false } = Astro.props;
const canonical = new URL(path, config.siteUrl).href;
const ogImage = new URL('/og.png', config.siteUrl).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#F6EFE3" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1E1B18" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preload" href="/fonts/fraunces-var.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Lovepins" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Lovepins: your love story, on one map. The app's map of New York with heart pins." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {config.launched && <meta name="apple-itunes-app" content={`app-id=${config.appStoreId}`} />}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="top wrap">
    <a class="brand" href="/" aria-label="Lovepins home">
      <img src="/icon-64.png" width="32" height="32" alt="" />
      <span>Lovepins</span>
    </a>
    {sectionNav ? (
      <nav aria-label="Main">
        <a href="#how">How it works</a>
        <a href="#pricing">Pricing</a>
        <a href="#faq">FAQ</a>
      </nav>
    ) : (
      <nav aria-label="Main" class="nav-always">
        <a href="/support/">Support</a>
        <a href="/privacy">Privacy</a>
      </nav>
    )}
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="foot wrap">
    <nav aria-label="Legal">
      <a href="/privacy">Privacy</a>
      <a href="/support/">Support</a>
      <a href={config.appleEulaUrl}>Terms of Use</a>
      <a href={`mailto:${config.contactEmail}`}>{config.contactEmail}</a>
    </nav>
    <p>© 2026 Lovepins. Apple, iPhone and App Store are trademarks of Apple Inc., registered in the U.S. and other countries.</p>
  </footer>
</body>
</html>
